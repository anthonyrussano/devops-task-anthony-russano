#!/bin/bash
set -euxo pipefail

PROXY_URL="http://${proxy_private_ip}:${egress_proxy_port}"
wait_for_proxy() {
  local proxy_host="$1"
  local proxy_port="$2"

  for attempt in $(seq 1 60); do
    if timeout 2 bash -c "</dev/tcp/$proxy_host/$proxy_port" 2>/dev/null; then
      return 0
    fi
    sleep 5
  done

  echo "Timed out waiting for egress proxy $proxy_host:$proxy_port" >&2
  return 1
}

wait_for_proxy "${proxy_private_ip}" "${egress_proxy_port}"

cat >/etc/profile.d/pci-poc-proxy.sh <<EOF
export http_proxy="$PROXY_URL"
export https_proxy="$PROXY_URL"
export HTTP_PROXY="$PROXY_URL"
export HTTPS_PROXY="$PROXY_URL"
export NO_PROXY="169.254.169.254,localhost,127.0.0.1"
EOF

cat >/etc/dnf/dnf.conf <<EOF
[main]
gpgcheck=True
installonly_limit=3
clean_requirements_on_remove=True
best=False
skip_if_unavailable=True
proxy=$PROXY_URL
EOF

# Placeholder for the startup dependency from the provided package repository.
# In a real rollout this should download and verify a signed package artifact.
mkdir -p /opt/pci-poc-app /var/www/pci-poc-app
curl --fail --silent --show-error --retry 12 --retry-delay 5 --proxy "$PROXY_URL" "https://${package_repository_host}/" >/opt/pci-poc-app/startup-package.html

cat >/var/www/pci-poc-app/index.html <<EOF
<!doctype html>
<html>
  <head><title>PCI POC App</title></head>
  <body>
    <h1>PCI POC App</h1>
    <p>Outbound dependencies are forced through the allowlisted proxy.</p>
    <p>Daily HTTPS dependency: ${daily_operation_host}</p>
  </body>
</html>
EOF

cat >/etc/systemd/system/pci-poc-app.service <<EOF
[Unit]
Description=PCI POC app service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/www/pci-poc-app
ExecStart=/usr/bin/python3 -m http.server ${app_port}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now pci-poc-app
